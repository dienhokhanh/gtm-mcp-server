{
  "name": "gtm-mcp-server",
  "version": "0.2.0",
  "description": "MCP server for creating and managing Google Tag Manager tags, triggers, and variables from Claude/Codex.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "gtm-mcp-server": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --import tsx --test test/*.test.ts",
    "check": "npm run build && npm test",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "auth": "tsx src/auth-cli.ts"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dienhokhanh/gtm-mcp-server.git"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "google-tag-manager",
    "gtm",
    "claude"
  ],
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "google-auth-library": "^11.1.0",
    "googleapis": "^182.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
